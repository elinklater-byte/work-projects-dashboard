# Copy this file to .env.local and fill in your own values.
# See README.md for step-by-step instructions on getting each of these.

# The ID from your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=

# The "client_email" field from your service account's JSON key file
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The "private_key" field from your service account's JSON key file.
# Keep it in quotes and keep the \n sequences exactly as they appear in the JSON file.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
